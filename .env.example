# WorldPulse environment configuration
#
# Copy to .env and edit. NOTHING in this file is required: with an empty
# .env (or no .env at all) WorldPulse runs in FREE mode against open data
# feeds that need no key, no registration and no payment.
#
#   cp .env.example .env && pip install -e ".[dev]" && pytest -q
#
# Legend:
#   [FREE]              works with no credential at all
#   [FREE, needs key]   zero cost, but requires a free registration
#   [OPTIONAL, PAID]    requires a paid subscription; never used by default


# =====================================================================
# Operating mode
# =====================================================================

# free -> only zero-cost providers may run (DEFAULT; /health reports
#         "data_mode": "FREE"). Paid providers are refused even if listed
#         in EVENT_PROVIDERS.
# paid -> allows paid providers to be selected as well.
WORLDPULSE_MODE=free


# =====================================================================
# Event providers  [FREE by default]
# =====================================================================

# Comma-separated list, evaluated in order. The default four need NO key.
#   gdelt     [FREE]              global news/events (GDELT DOC 2.0 API)
#   usgs      [FREE]              earthquakes (USGS FDSN + summary feeds)
#   eonet     [FREE]              natural events (NASA EONET v3)
#   gdacs     [FREE]              multi-hazard disaster alerts (GDACS)
#   firms     [FREE, needs key]   active fire detections (NASA FIRMS)
#   acled     [FREE, needs key]   political violence / protests (ACLED)
#   worldmonitor [OPTIONAL, PAID] World Monitor intel API
#   synthetic [FREE]              deterministic offline generator (demo/tests)
#
# Providers whose credential is missing disable themselves and are skipped
# with a logged reason -- they never crash startup. See GET /health/providers.
EVENT_PROVIDERS=gdelt,usgs,eonet,gdacs

# Classifier backend.
#   rules -> deterministic keyword/rule classifier (DEFAULT, needs NO key)
#   llm   -> OpenAI-compatible structured output; needs an LLM key below
#            and falls back to `rules` with a warning if none is set.
AI_CLASSIFIER=rules

# Optional country focus (ISO-3166 alpha-2, e.g. "IN" for India). When set:
#   - gdelt   narrows its query server-side (`sourcecountry:<fips>`)
#   - usgs    narrows its FDSN query server-side with a lat/lon bounding box
#             (plus a client-side bbox filter as a safety net)
#   - eonet, gdacs have no country parameter upstream, so results are
#     filtered client-side by coordinates/country/headline instead
# Leave unset for the default global feed. See
# ingestion/providers/country_focus.py for the supported country table.
# COUNTRY_FOCUS=IN


# =====================================================================
# Market data  [FREE]
# =====================================================================

# synthetic -> deterministic offline OHLCV generator (DEFAULT, no network)
# binance   -> Binance public klines [FREE, no auth]; crypto, real hourly
# stooq     -> Stooq CSV [FREE, no auth]; indices/futures/FX/ETFs, DAILY ONLY
# free      -> Binance for crypto + Stooq for the rest + synthetic fallback
# yfinance  -> requires the optional `yfinance` package
MARKET_DATA_PROVIDER=synthetic


# =====================================================================
# Optional FREE registration keys  [FREE, needs key]
# =====================================================================
# Each is zero cost and instantly issued. Leave blank to skip the provider.

# NASA FIRMS MAP_KEY -- https://firms.modaps.eosdis.nasa.gov/api/
NASA_FIRMS_API_KEY=

# FRED (St. Louis Fed) -- https://fredaccount.stlouisfed.org/apikeys
# Context/feature source only (macro time series). NOT an event source.
FRED_API_KEY=

# EIA Open Data -- https://www.eia.gov/opendata/
# Context/feature source only (energy time series). NOT an event source.
EIA_API_KEY=

# ACLED -- https://acleddata.com/register/ (both values required)
ACLED_EMAIL=
ACLED_PASSWORD=


# =====================================================================
# Optional PAID
# =====================================================================

# World Monitor intel API. [OPTIONAL, PAID]
# Not in the default EVENT_PROVIDERS, and refused entirely while
# WORLDPULSE_MODE=free. WorldPulse is fully functional with this unset.
WORLDMONITOR_API_KEY=


# =====================================================================
# Optional LLM keys (all optional; AI_CLASSIFIER=rules needs none)
# =====================================================================
OPENAI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=


# =====================================================================
# Database
# =====================================================================
# Default: local SQLite file, zero external services required.
DATABASE_URL=sqlite:///./worldpulse.db
# Postgres + pgvector alternative for a "real" deployment:
# DATABASE_URL=postgresql+psycopg2://worldpulse:worldpulse@localhost:5432/worldpulse


# =====================================================================
# Prediction thresholds
# =====================================================================
IMPACT_THRESHOLD=0.60


# =====================================================================
# Deduplication
# =====================================================================
# Same-provider near-duplicate news dedup (embedding similarity path).
DEDUP_WINDOW_HOURS=6.0
DEDUP_SIMILARITY_THRESHOLD=0.55
# Cross-source merge rule (different providers, same real-world event).
CROSS_SOURCE_WINDOW_HOURS=6.0
CROSS_SOURCE_GEO_WINDOW_HOURS=2.0
CROSS_SOURCE_GEO_RADIUS_KM=150.0


# =====================================================================
# HTTP client (shared by every provider)
# =====================================================================
HTTP_TIMEOUT_SECONDS=20.0
HTTP_MAX_RETRIES=3
HTTP_BACKOFF_BASE_SECONDS=0.5


# =====================================================================
# Provider fetch limits
# =====================================================================
GDELT_MAX_RECORDS=75
USGS_MIN_MAGNITUDE=4.5
FIRMS_CLUSTER_RADIUS_KM=50.0
FIRMS_CLUSTER_WINDOW_HOURS=24.0
FIRMS_MIN_CLUSTER_DETECTIONS=5


# =====================================================================
# Impact channel mapping table
# =====================================================================
IMPACT_CHANNELS_PATH=config/impact_channels.yaml


# =====================================================================
# Scheduler intervals (seconds)
# =====================================================================
NEWS_INGEST_INTERVAL_SECONDS=300
MARKET_INGEST_INTERVAL_SECONDS=300
PREDICTION_INTERVAL_SECONDS=600
RESOLUTION_INTERVAL_SECONDS=900


# =====================================================================
# Misc
# =====================================================================
RANDOM_SEED=42
