__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# Local SQLite databases and journals
*.db
*.db-journal
*.sqlite
*.sqlite3

# Env files
.env

# Virtual environments
.venv/
venv/

# OS/editor
.DS_Store

# worldtune-engine.sh runtime state (PIDs, logs)
.run/

# Platform runtime state (PIDs, logs) written by start-worldtune.sh
.worldtune-run/

# Frontend build artefacts
frontend/node_modules/
frontend/.next/
frontend/tsconfig.tsbuildinfo

# Large data: bulk raw/processed GDELT and intermediate layers stay local.
# Only the small published World Shift artifact ships with the repo so a fresh
# clone can serve the UI immediately (see start-worldtune.sh).
data/raw/
data/processed/*
!data/processed/worldtune/
data/processed/worldtune/*
!data/processed/worldtune/world_shifts/
data_test/

# Local credential notes must never be committed
docs/api keys*
