# ---------------------------------------------------------------------------
# WorldTune configuration. EVERY value here is optional.
# With this file absent entirely, the API starts, seeds demo data and serves a
# fully populated dashboard. That is the non-negotiable "no paid infra" path.
# ---------------------------------------------------------------------------

# Demo mode (default true). When true, every provider resolves to its
# deterministic seeded Demo* adapter and NO outbound network call is made.
DEMO_MODE=true

# SQLite by default -> zero external services. docker-compose overrides this
# with a Postgres+pgvector URL.
DATABASE_URL=sqlite:///./worldtune.db

# Auto-seed demo data on API startup when the DB is empty (default true).
AUTO_SEED=true

# --- Optional provider credentials (all blank => that provider reports
# --- is_available() == False and is skipped, never crashes) ---
# Adzuna: free developer registration at https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# GitHub personal access token: optional, only raises the rate limit.
GITHUB_TOKEN=

# --- Optional LLM explanation layer ---
# Blank => TemplatedExplainer (no network, no key). Set a key to enable the
# OpenAI-compatible LLMExplainer.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# --- HTTP / safety knobs ---
HTTP_TIMEOUT_SECONDS=10.0
HTTP_MAX_RETRIES=3
HTTP_BACKOFF_BASE_SECONDS=0.5
REQUEST_TIMEOUT_SECONDS=20.0
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
